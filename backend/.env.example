# Server Configuration
PORT=3000
NODE_ENV=development

# Garmin OAuth (Garth-style consumer - required for SSO login)
GARMIN_OAUTH_CONSUMER_KEY=
GARMIN_OAUTH_CONSUMER_SECRET=

# OpenAI API Key (required for AI processing)
# Get from: https://platform.openai.com/api/keys
OPENAI_API_KEY=

# CORS Settings (allow Expo development clients)
CORS_ORIGIN=

# App API Key (shared secret with app - must match EXPO_PUBLIC_APP_API_KEY in app .env)
APP_API_KEY=
