    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.0",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.10",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.0",
