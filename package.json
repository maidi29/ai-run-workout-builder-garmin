{
  "name": "ai-run-workout-builder",
  "version": "1.0.0",
  "description": "Expo React Native app to create workouts in Garmin Connect via AI-powered text/image recognition",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios"
  },
  "keywords": [
    "expo",
    "react-native",
    "garmin",
    "workout",
    "fitness",
    "openai",
    "ai"
  ],
  "author": "",
  "license": "MIT",
